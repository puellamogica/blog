{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "20190716.xyz",
      "custom_domain": true,
    },
  ],
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["grafana-traces"],
      "head_sampling_rate": 1,
      "persist": true,
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-logs"],
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "placement": {
    "mode": "smart",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "e084ddd8c2c243d789c4dac46dd105fa",
    },
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "blog",
    },
  ],
  "secrets_store_secrets": [],
  "d1_databases": [],
  "images": {
    "binding": "IMAGES",
  },
}
