{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "20190716.xyz",
      "custom_domain": true,
    },
  ],
  "observability": {
    "traces": {
      "enabled": true,
      "destinations": ["grafana-traces"],
      "head_sampling_rate": 1,
      "persist": true,
    },
    "logs": {
      "enabled": true,
      "destinations": ["grafana-logs"],
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
  },
  "placement": {
    "mode": "smart",
  },
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAEqjV5zVFaxo81wf",
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "e084ddd8c2c243d789c4dac46dd105fa",
    },
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "blog",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "ARGON2_ENDPOINT",
      "store_id": "c5b03c1fc22547d0bb1ee70629d4b6dd",
      "secret_name": "ARGON2_ENDPOINT",
    },
    {
      "binding": "ARGON2_HMAC_SECRET",
      "store_id": "c5b03c1fc22547d0bb1ee70629d4b6dd",
      "secret_name": "ARGON2_HMAC_SECRET",
    },
    {
      "binding": "ARGON2_PEPPER",
      "store_id": "c5b03c1fc22547d0bb1ee70629d4b6dd",
      "secret_name": "ARGON2_PEPPER",
    },
    {
      "binding": "VERCEL_PROTECTION_BYPASS",
      "store_id": "c5b03c1fc22547d0bb1ee70629d4b6dd",
      "secret_name": "VERCEL_PROTECTION_BYPASS",
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "c5b03c1fc22547d0bb1ee70629d4b6dd",
      "secret_name": "TURNSTILE_SECRET",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "11c0f682-7f38-41e4-87e0-3d15e549b020",
      "migrations_dir": "migrations",
    },
  ],

  "images": {
    "binding": "IMAGES",
  },
}
