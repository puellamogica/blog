---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { images, label = "Image gallery" } = Astro.props;
---

<!--
  Plain images in a container; the carousel is built by
  `src/scripts/swiper-gallery.ts`.

  It shows one slide at a time and spans the viewport, so the candidate widths
  are screen widths rather than a column's. The drawings are all wider than
  1920, so nothing here is ever upscaled.

  Every slide loads up front rather than on approach, so the carousel is whole
  by the time the page loader lifts and no slide is ever a blank frame waiting
  to be dragged into view.
-->
<div class="swiper-gallery" aria-label={label}>
  {images.map((image) => (
    <Image
      src={image.src}
      alt={image.alt}
      widths={[480, 768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      decoding="async"
    />
  ))}
</div>

<script>
  import { enhanceSwiperGalleries } from "../scripts/swiper-gallery";

  enhanceSwiperGalleries();
</script>
