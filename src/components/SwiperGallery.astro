---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { images, label = "Image gallery" } = Astro.props;
---

<!-- Plain images in a container; the carousel is built by `src/scripts/swiper-gallery.ts`. -->
<div class="swiper-gallery" aria-label={label}>
  {images.map((image) => (
    <Image
      src={image.src}
      alt={image.alt}
      widths={[480, 768, 960]}
      sizes="(min-width: 768px) 768px, 100vw"
      loading="lazy"
      decoding="async"
    />
  ))}
</div>

<script>
  import { enhanceSwiperGalleries } from "../scripts/swiper-gallery";

  enhanceSwiperGalleries();
</script>
