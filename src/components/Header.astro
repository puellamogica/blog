---
import { NAV_ITEMS, SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/85 backdrop-blur">
  <div class="site-container">
    <nav class="navbar px-0" aria-label="Main">
      <div class="navbar-start gap-1">
        <button
          id="drawer-open"
          type="button"
          class="btn btn-ghost btn-square lg:hidden"
          aria-controls="site-drawer"
          aria-expanded="false"
          aria-label="Open navigation"
        >
          <Icon name="menu" class="size-5" />
        </button>
        <a href="/" class="btn btn-ghost px-2 text-lg font-bold tracking-tight">
          {SITE_TITLE}
        </a>
      </div>
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 text-base">
          {NAV_ITEMS.map((item) => (
            <li>
              <HeaderLink href={item.href} match={item.match}>
                {item.label}
              </HeaderLink>
            </li>
          ))}
        </ul>
      </div>
      <div class="navbar-end gap-1">
        <ThemeToggle />
        <div class="hidden sm:block">
          <SocialLinks
            buttonClass="btn btn-ghost btn-square btn-sm"
            iconClass="size-4"
          />
        </div>
      </div>
    </nav>
  </div>
</header>
