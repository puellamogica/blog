---
import {
  NAV_ITEMS,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_WORDMARK,
  SOCIAL_LINKS,
} from "../consts";

const today = new Date();
---

<footer class="border-base-300 mt-auto border-t">
  <div class="site-container py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,2fr)_1fr_1fr]">
      <div class="max-w-xs">
        <a href="/" class="wordmark">
          {SITE_WORDMARK.name}
          {SITE_WORDMARK.suffix && (
            <span class="wordmark-suffix">.{SITE_WORDMARK.suffix}</span>
          )}
        </a>
        <p class="text-base-content/70 mt-3 text-sm">{SITE_DESCRIPTION}</p>
        <p class="mono-data mt-4">
          &copy; {today.getFullYear()} {SITE_TITLE}
        </p>
      </div>

      <nav aria-label="Site">
        <h2 class="mono-label">Site</h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          {NAV_ITEMS.map((item) => (
            <li>
              <a class="link-quiet" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Social">
        <h2 class="mono-label">Elsewhere</h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          {SOCIAL_LINKS.map(({ href, name, label }) => (
            <li>
              <a
                class="link-quiet"
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
              >
                {name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
