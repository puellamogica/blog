  <nav class="grid grid-flow-col gap-4" aria-label="購読とサイト案内">
    <a class="link link-hover" href="/rss.xml">
      RSS
    </a>
    <a class="link link-hover" href="/sitemap-index.xml">
      SITEMAP
    </a>
  </nav>

  <aside>
    <p class="text-base-content/60">
      &copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
    </p>
  </aside>
</footer>
