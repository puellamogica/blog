---
import { NAV_ITEMS, SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const today = new Date();
---

<footer class="footer footer-horizontal footer-center bg-base-200 text-base-content mt-auto p-10">
  <nav class="grid grid-flow-col gap-4" aria-label="サイト内リンク">
    {NAV_ITEMS.map((item) => (
      <a class="link link-hover" href={item.href}>
        {item.label}
      </a>
    ))}
  </nav>

  <aside>
    <p class="text-base-content/70">{SITE_DESCRIPTION}</p>
    <p class="text-base-content/60">
      &copy; {today.getFullYear()} {SITE_TITLE}
    </p>
  </aside>
</footer>
