---
import { SOCIAL_LINKS } from "../consts";
import Icon from "./Icon.astro";

interface Props {
  buttonClass?: string;
  iconClass?: string;
}

const { buttonClass = "btn btn-ghost btn-square", iconClass = "size-5" } =
  Astro.props;
---

<div class="flex items-center gap-1">
  {SOCIAL_LINKS.map(({ href, label, icon }) => (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonClass}
      aria-label={label}
    >
      <Icon name={icon} class={iconClass} />
    </a>
  ))}
</div>
