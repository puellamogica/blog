---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CategoryBadge from "../components/CategoryBadge.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TableOfContents.astro";
import BaseLayout from "./BaseLayout.astro";

type Props = CollectionEntry<"article">["data"] & {
  headings: MarkdownHeading[];
  noindex?: boolean;
};
type Crumb = { href?: string; label: string };

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  headings,
  noindex = false,
} = Astro.props;

const crumbs: Crumb[] = Astro.url.pathname.startsWith("/article")
  ? [
      { href: "/", label: "Home" },
      { href: "/posts", label: "Posts" },
      { label: title },
    ]
  : [{ href: "/", label: "Home" }, { label: title }];
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  noindex={noindex}
>
  <article class="site-container py-8 sm:py-12">
    <div class="lg:flex lg:justify-center lg:gap-10">
      <div class="mx-auto w-full max-w-3xl">
        <nav class="breadcrumbs mb-4 text-sm" aria-label="Breadcrumb">
          <ul>
            {crumbs.map((crumb) => (
              <li class="max-w-64 truncate">
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  crumb.label
                )}
              </li>
            ))}
          </ul>
        </nav>

        <header class="mb-8 flex flex-col gap-3">
          <div class="flex flex-wrap items-center gap-2">
            <CategoryBadge category={category} />
            <span class="badge badge-neutral">
              <FormattedDate date={pubDate} />
            </span>
            {updatedDate && (
              <span class="badge badge-ghost">
                Updated <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
          <h1 class="page-title">{title}</h1>
          <p class="page-lead">{description}</p>
        </header>

        {heroImage && (
          <figure class="rounded-box mb-10 overflow-hidden">
            <Image
              width={1020}
              height={510}
              src={heroImage}
              alt=""
              class="h-auto w-full object-cover"
            />
          </figure>
        )}

        <div class="prose max-w-none lg:prose-lg">
          <slot />
        </div>
      </div>

      <TableOfContents headings={headings} />
    </div>
  </article>
</BaseLayout>

<script>
  import PhotoSwipeDynamicCaption from "photoswipe-dynamic-caption-plugin";
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  // Astro resolves markdown images to their optimised URLs while rendering,
  // which is after the markdown plugins have run, so the lightbox is wired up
  // here in the browser. PhotoSwipe reads the large image and its dimensions
  // from the link around each thumbnail, so wrap every content image in one and
  // carry the rendered size across as data attributes.
  const gallery = document.querySelector<HTMLElement>(".prose");
  const images = gallery?.querySelectorAll<HTMLImageElement>("img") ?? [];

  for (const image of images) {
    if (image.closest("a")) continue;

    const width = Number(image.getAttribute("width")) || image.naturalWidth;
    const height = Number(image.getAttribute("height")) || image.naturalHeight;
    if (!width || !height) continue;

    const link = document.createElement("a");
    link.className = "pswp-item";
    link.href = image.currentSrc || image.src;
    link.dataset.pswpWidth = String(width);
    link.dataset.pswpHeight = String(height);

    image.replaceWith(link);
    link.appendChild(image);
  }

  if (gallery?.querySelector("a.pswp-item")) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: "a.pswp-item",
      pswpModule: () => import("photoswipe"),
    });

    // Captions fall back to each image's `alt` text and are placed beside or
    // below the photo depending on the space the viewport has for them.
    new PhotoSwipeDynamicCaption(lightbox, { type: "auto" });

    // PhotoSwipe has to be initialised after its plugins are attached.
    lightbox.init();
  }
</script>

<script>
  // Expressive Code makes wide code blocks horizontally scrollable. Without a
  // tab stop they cannot be scrolled by keyboard, so mark the overflowing ones
  // focusable and keep that in sync as the viewport changes.
  const codeBlocks = document.querySelectorAll<HTMLElement>(
    ".expressive-code pre",
  );
  const syncFocusable = (block: HTMLElement) => {
    block.tabIndex = block.scrollWidth > block.clientWidth ? 0 : -1;
  };
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) syncFocusable(entry.target as HTMLElement);
  });
  for (const block of codeBlocks) {
    syncFocusable(block);
    observer.observe(block);
  }
</script>

<script>
  // Markdown emits raw <audio>/<video> elements, so Plyr is wired up here in
  // the browser. It is only fetched on pages that actually contain media, and
  // the icons are served from this site rather than Plyr's default CDN.
  const media = document.querySelectorAll<HTMLMediaElement>(
    ".prose audio, .prose video",
  );

  if (media.length > 0) {
    void import("plyr").then(({ default: Plyr }) => {
      for (const element of media) {
        new Plyr(element, { iconUrl: "/plyr.svg" });
      }
    });
  }
</script>
