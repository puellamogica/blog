---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HeaderLink from "../components/HeaderLink.astro";
import Icon from "../components/Icon.astro";
import { NAV_ITEMS, SITE_WORDMARK } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
const drawerId = "site-drawer";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body class="min-h-dvh">
    <div class="drawer">
      <input
        id={drawerId}
        type="checkbox"
        class="drawer-toggle"
        tabindex="-1"
        aria-hidden="true"
      />
      <div class="drawer-content flex min-h-dvh flex-col">
        <Header />
        <main class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>
      <nav class="drawer-side z-50" aria-label="Mobile navigation">
        <label
          for={drawerId}
          id="drawer-overlay"
          class="drawer-overlay"
          aria-label="Close navigation"
        ></label>
        <div
          id="drawer-panel"
          class="bg-base-100 border-base-300 flex min-h-full w-72 max-w-[80vw] flex-col gap-2 border-e p-5"
        >
          <div class="flex items-center justify-between gap-2">
            <a href="/" class="wordmark">
              {SITE_WORDMARK.name}
              {SITE_WORDMARK.suffix && (
                <span class="wordmark-suffix">.{SITE_WORDMARK.suffix}</span>
              )}
            </a>
            <button
              id="drawer-close"
              type="button"
              class="btn btn-ghost btn-square btn-sm"
              aria-label="Close navigation"
            >
              <Icon name="close" class="size-5" />
            </button>
          </div>
          <ul class="mt-6 grow">
            {NAV_ITEMS.map((item) => (
              <li>
                <HeaderLink
                  href={item.href}
                  match={item.match}
                  class="block py-3 text-lg"
                >
                  {item.label}
                </HeaderLink>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <script is:inline>
      (() => {
        const toggle = document.getElementById("site-drawer");
        const openButton = document.getElementById("drawer-open");
        const closeButton = document.getElementById("drawer-close");
        const overlay = document.getElementById("drawer-overlay");
        const panel = document.getElementById("drawer-panel");
        if (
          !(toggle instanceof HTMLInputElement) ||
          !(openButton instanceof HTMLButtonElement)
        )
          return;

        const setOpen = (open) => {
          toggle.checked = open;
          openButton.setAttribute("aria-expanded", String(open));
          if (open) {
            window.setTimeout(() => {
              if (!toggle.checked) return;
              const first = panel?.querySelector("a, button");
              if (first instanceof HTMLElement) first.focus();
            }, 250);
          } else {
            openButton.focus();
          }
        };

        openButton.addEventListener("click", () => setOpen(!toggle.checked));
        closeButton?.addEventListener("click", () => setOpen(false));
        overlay?.addEventListener("click", (event) => {
          event.preventDefault();
          setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.checked) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
