---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HeaderLink from "../components/HeaderLink.astro";
import Icon from "../components/Icon.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { NAV_ITEMS, SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
const drawerId = "site-drawer";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="min-h-dvh">
    <div class="drawer">
      <input
        id={drawerId}
        type="checkbox"
        class="drawer-toggle"
        tabindex="-1"
        aria-hidden="true"
      />
      <div class="drawer-content flex min-h-dvh flex-col">
        <Header />
        <main class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>
      <nav class="drawer-side z-50" aria-label="Mobile navigation">
        <label
          for={drawerId}
          id="drawer-overlay"
          class="drawer-overlay"
          aria-label="Close navigation"
        ></label>
        <div
          id="drawer-panel"
          class="flex min-h-full w-80 flex-col gap-4 bg-base-200 p-4"
        >
          <div class="flex items-center justify-between gap-2">
            <a
              href="/"
              class="btn btn-ghost px-2 text-lg font-bold tracking-tight"
            >
              {SITE_TITLE}
            </a>
            <button
              id="drawer-close"
              type="button"
              class="btn btn-ghost btn-square btn-sm"
              aria-label="Close navigation"
            >
              <Icon name="close" class="size-5" />
            </button>
          </div>
          <ul class="menu w-full grow gap-1 text-base">
            {NAV_ITEMS.map((item) => (
              <li>
                <HeaderLink href={item.href} match={item.match}>
                  {item.label}
                </HeaderLink>
              </li>
            ))}
          </ul>
          <div class="border-t border-base-300 pt-4">
            <p class="mb-2 px-1 text-xs font-semibold tracking-wide text-base-content/70 uppercase">
              Elsewhere
            </p>
            <SocialLinks />
          </div>
        </div>
      </nav>
    </div>

    <script is:inline>
      (() => {
        const toggle = document.getElementById("site-drawer");
        const openButton = document.getElementById("drawer-open");
        const closeButton = document.getElementById("drawer-close");
        const overlay = document.getElementById("drawer-overlay");
        const panel = document.getElementById("drawer-panel");
        if (
          !(toggle instanceof HTMLInputElement) ||
          !(openButton instanceof HTMLButtonElement)
        )
          return;

        const setOpen = (open) => {
          toggle.checked = open;
          openButton.setAttribute("aria-expanded", String(open));
          if (open) {
            window.setTimeout(() => {
              if (!toggle.checked) return;
              const first = panel?.querySelector("a, button");
              if (first instanceof HTMLElement) first.focus();
            }, 250);
          } else {
            openButton.focus();
          }
        };

        openButton.addEventListener("click", () => setOpen(!toggle.checked));
        closeButton?.addEventListener("click", () => setOpen(false));
        overlay?.addEventListener("click", (event) => {
          event.preventDefault();
          setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.checked) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
