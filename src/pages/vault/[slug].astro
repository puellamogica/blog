---
export const prerender = false; // Not needed in 'server' mode

import { render } from "astro:content";
import { env } from "cloudflare:workers";
import BlogPost from "../../layouts/BlogPost.astro";
import { getVaultEntry } from "../../utils/posts";
import { isUnlocked } from "../../utils/vault-auth";

const { slug } = Astro.params;
if (slug === undefined) {
  return Astro.redirect("/404");
}

const post = await getVaultEntry(slug);
if (post === undefined) {
  return new Response(null, { status: 404 });
}

const userid = await Astro.session?.get("userid");
const nowSeconds = Math.floor(Date.now() / 1000);

if (
  userid === undefined ||
  !(await isUnlocked(env.DB, userid, slug, nowSeconds))
) {
  return Astro.redirect(`/login/${slug}`);
}

const { Content, remarkPluginFrontmatter } = await render(post);
---

<BlogPost {...post.data} noindex>
  <p>{remarkPluginFrontmatter.minutesRead}</p>
  <Content />
</BlogPost>
