---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
>
  <section class="site-container py-16 sm:py-24">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] sm:items-center sm:gap-16">
      <figure class="border-base-300 border">
        <img
          src="/404.jpg"
          alt="A cat hiding under a pile of printed pages"
          width="750"
          height="600"
          class="h-auto w-full object-cover"
        />
      </figure>
      <div>
        <p class="mono-label">Error 404</p>
        <h1 class="page-title mt-4">Page not found</h1>
        <p class="page-lead mt-5">
          That URL doesn’t lead anywhere. It may have moved, or it never existed
          — and the cat isn’t saying.
        </p>
        <a href="/" class="btn btn-primary mt-8">
          Back home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
