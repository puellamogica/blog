---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
>
  <section class="hero min-h-[70vh]">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <p class="text-7xl font-extrabold text-primary">404</p>
        <h1 class="mt-4 text-2xl font-bold tracking-tight">Page not found</h1>
        <p class="py-6 text-pretty text-base-content/70">
          That URL doesn’t lead anywhere. It may have moved, or it never
          existed.
        </p>
        <a href="/" class="btn btn-primary">
          Back home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
