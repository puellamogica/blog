---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
>
  <section class="hero min-h-[70vh]">
    <div class="hero-content flex-col gap-8 text-center lg:flex-row lg:gap-12 lg:text-left">
      <figure>
        <img
          src="/http-cat-404.jpg"
          alt="A cat hiding under a pile of printed pages"
          width="750"
          height="600"
          class="rounded-box w-64 sm:w-80"
        />
      </figure>
      <div class="max-w-md">
        <h1 class="text-2xl font-bold tracking-tight">Page not found</h1>
        <p class="py-6 text-pretty text-base-content/70">
          That URL doesn’t lead anywhere. It may have moved, or it never existed
          — and the cat isn’t saying.
        </p>
        <a href="/" class="btn btn-primary">
          Back home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
