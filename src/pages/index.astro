---
import { Image } from "astro:assets";
import CategoryBadge from "../components/CategoryBadge.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PostEntry from "../components/PostEntry.astro";
import WeatherWidget from "../components/WeatherWidget.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { byPinnedThenDate, getArticles } from "../utils/posts";
/*
 * The masthead image. Swap this one import for the site's own main visual; it is
 * rendered through the image pipeline, so any wide source works.
 */
import MastheadImage from "../assets/mizuki-gallery/003.webp";

const posts = (await getArticles()).sort(byPinnedThenDate);
const [lead, ...rest] = posts;
const index = rest.slice(0, 5);
const since =
  posts.length === 0
    ? undefined
    : Math.min(...posts.map((post) => post.data.pubDate.getFullYear()));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!--
    The masthead.

    Below `lg` this is a plain figure: the image, then the description under it.
    From `lg` the three children stack into one daisyUI hero cell and the
    description moves onto the image itself.

    The scrim is deliberately not a theme token. The picture does not change when
    the theme does, so a token that flips from paper to ink would leave dark text
    on a dark picture in one of the two themes. A fixed dark scrim under fixed
    light text is the only version that reads in both.

    It is weighted towards the bottom, where the text sits, so the top of the
    artwork stays clean, and it carries the same bottom mask as the image so the
    two fade into the page together.
  -->
  <section class="lg:hero bg-base-100">
    <Image
      src={MastheadImage}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      class="aspect-[16/10] w-full object-cover lg:aspect-auto lg:h-[clamp(20rem,42vw,30rem)] lg:mask-b-from-92%"
    />
    <div class="lg:hero-overlay bg-linear-to-t from-black/92 via-black/72 to-transparent lg:mask-b-from-92%"></div>
    <div class="lg:hero-content lg:max-w-none lg:items-end lg:justify-self-stretch lg:self-stretch lg:p-0">
      <!--
        daisyUI's hero centres its items, so the content box has to be stretched
        back out; and the container's own `mx-auto` has to come off, because as a
        flex item its auto margins absorb the free space first. Between them the
        text would otherwise shrink-wrap and sit centred instead of holding the
        page's left edge the way every other section does.
      -->
      <div class="site-container flex-1 pt-10 pb-10 lg:mx-0 lg:pt-0 lg:pb-12">
        <h1 class="display-title max-w-3xl text-balance lg:text-white">
          {SITE_DESCRIPTION}
        </h1>
        <p class="data mt-8 lg:text-white/80">
          {posts.length} 件{since !== undefined && <>（{since}年以降）</>}
        </p>
      </div>
    </div>
  </section>

  {lead && (
    <section class="site-container pb-16 sm:pb-20">
      <div class="rule-ink"></div>
      <p class="label mt-4">最新</p>

      <article class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-start lg:gap-12">
        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <CategoryBadge category={lead.data.category} />
            <span class="data">
              <FormattedDate date={lead.data.pubDate} />
            </span>
          </div>
          <h2 class="display-title mt-5">
            <a
              href={`/${lead.collection}/${lead.data.slug}`}
              class="hover:text-primary transition-colors"
            >
              {lead.data.title}
            </a>
          </h2>
          <p class="page-lead mt-5">{lead.data.description}</p>
        </div>

        {lead.data.heroImage && (
          <figure class="border-base-300 border">
            <Image
              width={720}
              height={480}
              src={lead.data.heroImage}
              alt=""
              class="h-full w-full object-cover"
            />
          </figure>
        )}
      </article>
    </section>
  )}

  <section class="site-container pb-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
      <div>
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="section-title">一覧</h2>
          <a href="/posts" class="link-quiet text-sm">
            すべての記事 →
          </a>
        </div>
        <div class="border-base-300 mt-6 border-t">
          {index.map((post) => (
            <PostEntry post={post} />
          ))}
        </div>
      </div>

      <WeatherWidget />
    </div>
  </section>
</BaseLayout>
