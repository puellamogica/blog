---
import PostCard from "../components/PostCard.astro";
import WeatherWidget from "../components/WeatherWidget.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { byPinnedThenDate, getArticles } from "../utils/posts";

const posts = (await getArticles()).sort(byPinnedThenDate).slice(0, 3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero bg-base-200 min-h-[70vh]">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <p class="badge badge-primary mb-4">Astro · Tailwind CSS · daisyUI</p>
        <h1 class="text-4xl font-extrabold tracking-tight text-balance sm:text-6xl">
          🧑🚀 Hello, Astronaut!
        </h1>
        <p class="py-6 text-base text-pretty text-base-content/70 sm:text-lg">
          {SITE_DESCRIPTION}
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <a href="/posts" class="btn btn-primary">
            Read the posts
          </a>
          <a href="/about" class="btn btn-ghost">
            About me
          </a>
        </div>
      </div>
    </div>
  </section>

  <WeatherWidget />

  <section class="site-container py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="section-title">Latest posts</h2>
        <p class="text-sm text-base-content/70">
          The three most recent articles.
        </p>
      </div>
      <a href="/posts" class="link text-sm">
        All posts →
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
