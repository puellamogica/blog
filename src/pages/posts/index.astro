---
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import {
  byPinnedThenDate,
  getArticles,
  getVaultEntries,
} from "../../utils/posts";

const posts = (await Promise.all([getArticles(), getVaultEntries()]))
  .flat()
  .sort(byPinnedThenDate);
---

<BaseLayout title={`Posts · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="site-container py-12 sm:py-16">
    <header class="mb-10 max-w-2xl">
      <h1 class="page-title">Posts</h1>
      <p class="page-lead mt-3">{posts.length} posts and counting.</p>
    </header>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
