---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServerErrorImage from "../assets/500.jpg";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const message =
  import.meta.env.DEV && error instanceof Error ? error.message : null;
---

<BaseLayout
  title="サーバーエラー"
  description="サーバー側で問題が発生しました。"
>
  <section class="site-container py-16 sm:py-24">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] sm:items-center sm:gap-16">
      <figure class="border-base-300 border">
        <Image
          src={ServerErrorImage}
          alt="開いたパソコンの筐体の中で寝ている猫"
          widths={[375, 750]}
          sizes="(width >= 40rem) 30rem, 100vw"
          class="h-auto w-full object-cover"
        />
      </figure>
      <div>
        <p class="label font-mono">500</p>
        <h1 class="page-title mt-4">サーバーエラー</h1>
        <p class="page-lead mt-5">
          サーバーがリクエストを処理できませんでした。一時的なものと思われるので、少し時間をおいてもう一度お試しください。
        </p>
        {message && (
          <p class="plate data mt-6 px-4 py-3 break-words">{message}</p>
        )}
        <a href="/" class="btn btn-primary mt-8">
          ホームへ戻る
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
