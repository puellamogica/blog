---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const message =
  import.meta.env.DEV && error instanceof Error ? error.message : null;
---

<BaseLayout
  title="Server error"
  description="Something went wrong on the server."
>
  <section class="hero min-h-[70vh]">
    <div class="hero-content flex-col gap-8 text-center lg:flex-row lg:gap-12 lg:text-left">
      <figure>
        <img
          src="/http-cat-500.jpg"
          alt="A cat sprawled inside an open computer case"
          width="750"
          height="600"
          class="rounded-box w-64 sm:w-80"
        />
      </figure>
      <div class="max-w-md">
        <h1 class="text-2xl font-bold tracking-tight">Something went wrong</h1>
        <p class="py-6 text-pretty text-base-content/70">
          The server couldn’t finish that request. It’s most likely temporary,
          so try again in a moment.
        </p>
        {message && (
          <p class="rounded-box bg-base-200 mb-6 p-4 text-left text-sm break-words">
            {message}
          </p>
        )}
        <a href="/" class="btn btn-primary">
          Back home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
