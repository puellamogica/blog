---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import MizukiGallery from "@components/MizukiGallery.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import NowWorldPc from "../assets/about/now-background-pc.webp";
import NowWorldPhone from "../assets/about/now-background.webp";
import NowFigurePc from "../assets/about/now-foreground-pc.webp";
import NowFigurePhone from "../assets/about/now-foreground.webp";
import PastWorldPc from "../assets/about/past-background-pc.webp";
import PastWorldPhone from "../assets/about/past-background.webp";
import PastFigurePc from "../assets/about/past-foreground-pc.webp";
import PastFigurePhone from "../assets/about/past-foreground.webp";
import PosterImage from "../assets/mizuki-gallery/013.webp";
import { SITE_TITLE } from "../consts";
import {
  defaultEra,
  eras,
  eraKeys,
  profile,
  rows,
  video,
  type Era,
} from "../data/profile";

/*
 * The two layers of the character band, per era: the world she is standing in,
 * and the figure standing in it. Each is authored twice, once as a tall phone
 * frame and once as a wide one, which is why the band swaps its art direction
 * at `md` the same way the home masthead does.
 *
 * The figure files are byte-identical for now, so the world is the only thing
 * that visibly changes between eras. They are wired per era anyway, because
 * that is what the file names promise and it is one edit to make them differ.
 */
type Layer = { phone: ImageMetadata; pc: ImageMetadata };

const stage = {
  past: {
    world: { phone: PastWorldPhone, pc: PastWorldPc },
    figure: { phone: PastFigurePhone, pc: PastFigurePc },
  },
  now: {
    world: { phone: NowWorldPhone, pc: NowWorldPc },
    figure: { phone: NowFigurePhone, pc: NowFigurePc },
  },
} satisfies Record<Era, { world: Layer; figure: Layer }>;

// A `<source>` needs a srcset rather than an <Image>, so the widths are built
// here. Both art directions are wider than any viewport they are shown at, so
// these stay below the source size and nothing is ever upscaled.
const srcset = async (src: ImageMetadata, widths: number[]) =>
  (
    await Promise.all(
      widths.map(async (width) => {
        const { src: url } = await getImage({ src, width, format: "webp" });
        return `${url} ${width}w`;
      }),
    )
  ).join(", ");

const layers = await Promise.all(
  eraKeys.map(async (era) => ({
    era,
    world: {
      phone: (
        await getImage({
          src: stage[era].world.phone,
          width: 900,
          format: "webp",
        })
      ).src,
      pc: await srcset(stage[era].world.pc, [1280, 1920, 2560]),
    },
    figure: {
      phone: (
        await getImage({
          src: stage[era].figure.phone,
          width: 750,
          format: "webp",
        })
      ).src,
      pc: await srcset(stage[era].figure.pc, [1024, 1600]),
    },
  })),
);

// Cropped to the player's own ratio, so the placeholder poster fills the frame
// instead of sitting in it with bars down both sides.
const poster = await getImage({
  src: PosterImage,
  width: 1280,
  height: 720,
  fit: "cover",
  format: "webp",
});

// Two columns per pair, so the widest row decides the grid and the data can
// grow a pair without the markup following it.
const columns = Math.max(...rows.map((row) => row.length)) * 2;
---

<BaseLayout
  title={`プロフィール · ${SITE_TITLE}`}
  description={`${profile.unit}の${profile.role}。`}
  image={stage[defaultEra].world.phone}
>
  <header class="site-container pt-14 pb-6 sm:pt-20">
    <h1 class="page-title">プロフィール</h1>
    <p class="data mt-4">
      {profile.unit} ／ {profile.role}
    </p>
  </header>

  <!--
    The era toggle, and the two views it switches between.

    daisyUI's `tabs` with radio inputs inside labels is the whole mechanism. The
    component styles the label, drops the input over it, and fills the one that
    is checked, so the toggle costs no JavaScript and works with scripting off.

    There are no tab roles here on purpose. A tablist whose children are radios
    rather than tabs is a promise the markup cannot keep, so the semantics are
    left to the native radio group and only the shape is borrowed.

    The panels are not daisyUI's `.tab-content`. Those have to be the next
    sibling of the tab that shows them, which would force the bar and everything
    it controls into one box. Keying the panels off the radios instead, in
    components.css, is what lets the toggle sit in the character band and still
    drive the world behind it and the sheet below it.

    Both eras run the same rows through the same map, so only the values that
    actually differ change, and the two views cannot drift apart.
  -->
  <div class="era">
    <!--
      The character band. Four layers, three of which only exist to be swapped:
      the era's world behind, the era's figure in front of it, both authored
      once for the phone and once for the wide screen.

      The art is absolute inside the band and the reading content sits over it,
      which is the reference page's arrangement. `--stage-art` is the height the
      art claims on a phone, where the figure needs its own band above the card;
      at `md` it collapses and the art fills the band instead. Setting it once as
      a variable is what keeps the layer and the content padding in step.
    -->
    <section class="[--stage-art:120vw] md:[--stage-art:0px] relative isolate overflow-hidden">
      <div
        class="stage-art pointer-events-none absolute inset-x-0 top-0 h-(--stage-art) md:inset-0 md:h-full"
        aria-hidden="true"
      >
        <!-- The era's world, edge to edge behind everything. -->
        {layers.map(({ era, world }) => (
          <picture data-era={era} class="absolute inset-0">
            <source media="(width >= 48rem)" srcset={world.pc} sizes="100vw" />
            <img
              src={world.phone}
              alt=""
              class="h-full w-full object-cover"
              fetchpriority={era === defaultEra ? "high" : "low"}
            />
          </picture>
        ))}

        <!--
          The era's figure, standing in the world.

          The box is the full container width and she is anchored to its left,
          because the artwork is drawn that way: she sits in the left third of
          the frame and the right two thirds are empty space that the card is
          meant to occupy. Contained in a half-width column instead, the box
          caps her scale and she comes out at about a third of the size the
          drawing can carry.

          On a phone the card sits below rather than beside, so there she is
          centred on the band.
        -->
        <div class="site-container relative h-full md:py-16">
          <div class="relative h-full">
            {layers.map(({ era, figure }) => (
              <picture data-era={era} class="absolute inset-0">
                <source
                  media="(width >= 48rem)"
                  srcset={figure.pc}
                  sizes="(width >= 48rem) 70vw, 100vw"
                />
                <img
                  src={figure.phone}
                  alt=""
                  class="h-full w-full object-contain object-bottom md:object-left-bottom"
                  fetchpriority="low"
                />
              </picture>
            ))}
          </div>
        </div>
      </div>

      <div class="site-container relative pt-(--stage-art) pb-12 md:pt-16 md:pb-16">
        <div class="md:grid md:min-h-[62svh] md:items-end md:grid-cols-2 md:gap-12">
          <!--
            The card holds the toggle, so the control sits on an opaque surface
            rather than on the artwork: the light pills have no contrast against
            a high-key illustration. The left column is left empty on purpose,
            because that is where the figure is.
          -->
          <div class="card bg-base-100 md:col-start-2">
            <div class="card-body">
              <div class="tabs tabs-box w-fit">
                {eraKeys.map((era) => (
                  <label class="tab min-h-11">
                    <input
                      type="radio"
                      name="era"
                      value={era}
                      checked={era === defaultEra}
                    />
                    {eras[era].label}
                  </label>
                ))}
              </div>

              <p class="label mt-2">{profile.romanised}</p>
              <h2 class="display-title mt-3">{profile.name}</h2>
              <p class="data mt-3">CV. {profile.voice}</p>

              <p class="page-lead mt-6">{profile.quote}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--
      The spec sheet. It is a real table because the data is: rows hold one
      name/value pair or two, and that pairing is preserved rather than
      flattened into a form. A one-pair row spans its value across the remaining
      columns, so that value stays flush with the right edge either way.

      The rules between rows come from `table` itself. It draws them on the cells
      rather than on the row, because it sets `border-collapse: separate`, so a
      border of our own on the <tr> would only fight it.

      The type sits on spans rather than on the cells. `label` is a daisyUI class
      and it is `inline-flex`, which on a <th> stops it being a table cell and
      lets the columns collapse to their content.

      The columns are pinned to even quarters so that a pair always owns half the
      row. Left to itself the browser sizes them by content and no two pairs line
      up, which is the whole point of the layout.
    -->
    {eraKeys.map((era) => (
      <div data-era={era} class="site-container pt-14 sm:pt-16">
        <h2 class="section-title">PROFILE</h2>

        <table class="table mt-6">
          <colgroup>
            {Array.from({ length: columns }).map(() => (
              <col class="w-1/4" />
            ))}
          </colgroup>
          <tbody>
            {rows.map((row) => (
              <tr>
                {row.map((cell) => (
                  <>
                    <th scope="row">
                      <span class="label">{cell.label}</span>
                    </th>
                    <td
                      class="text-right"
                      colspan={row.length === 1 ? columns - 1 : undefined}
                    >
                      <span class="data">
                        {typeof cell.value === "string"
                          ? cell.value
                          : cell.value[era]}
                      </span>
                    </td>
                  </>
                ))}
              </tr>
            ))}
          </tbody>
        </table>

        <h2 class="section-title mt-14">紹介</h2>

        <!--
            Running text keeps the site's prose styles, which carry the Japanese
            leading the rest of the site is set with.
          -->
        <div class="prose mt-6 max-w-[65ch]">
          {eras[era].description.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!--
    The source is a placeholder until the real file lands, and it is set in one
    place, in src/data/profile.ts. `preload="metadata"` keeps a video nobody has
    pressed play on from costing a full download, and the poster means the
    player reads as a frame from the film rather than as a black hole.
  -->
  <section class="site-container py-14 sm:py-16">
    <h2 class="section-title">{video.title}</h2>

    <figure class="border-base-300 mt-6 border" data-media>
      <video
        class="aspect-video h-auto w-full"
        controls
        preload="metadata"
        poster={poster.src}
      >
        <source src={video.src} />
      </video>
    </figure>
  </section>

  <section class="site-container pb-20">
    <MizukiGallery />
  </section>
</BaseLayout>

<script>
  /*
   * The same media pattern the article layout uses: the markup is a plain
   * <video controls>, so it plays with scripting off, and the player is only
   * built on a page that actually has one.
   */
  import { enhanceMediaPlayers } from "../scripts/media-player";

  enhanceMediaPlayers("[data-media] video");
</script>
